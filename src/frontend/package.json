{
  "name": "frontend-content",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "aws-amplify": "^6.22.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "production": "./productionBuild.sh",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:backend": "cd ../.. && eslint --config src/frontend/eslint.config.js src test",
    "format": "cd ../.. && prettier --write \"src/**/*.{js,jsx,mjs}\" \"test/**/*.{js,mjs}\"",
    "format:check": "cd ../.. && prettier --check \"src/**/*.{js,jsx,mjs}\" \"test/**/*.{js,mjs}\""
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
